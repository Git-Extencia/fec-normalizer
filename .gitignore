# Environnement virtuel Python
.venv/
venv/
env/

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------------
# CRITIQUE — ne JAMAIS pousser de données client sur GitHub.
# Cette section couvre tous les fichiers FEC réels ou enrichis.
# ----------------------------------------------------------------------------

# Fichiers FEC bruts (clients réels OU synthétiques de test)
# On cible uniquement les FEC, pas tous les .txt (sinon requirements.txt serait exclu)
fec_*.txt
fec_*.csv
*FEC*.txt
*FEC*.csv
[0-9]*.txt

# Sorties enrichies et diagnostics (peuvent contenir des dérivés client)
*_enrichi.xlsx
*_enrichi.parquet
*_diagnostic.xlsx
*_diagnostic.json
fec_enrichi.*
diagnostic_fec.*

# Dossiers de tests temporaires
audit_test/
resultats_test/
out_*/

# Archives projet (peuvent contenir des références historiques sensibles)
archives/

# ----------------------------------------------------------------------------
# Documents Word/PDF (livrables locaux, pas du code)
# ----------------------------------------------------------------------------
*.docx
*.pdf
# Exception : le manuel utilisateur est embarqué dans l'image Docker
# pour être servi en téléchargement depuis la page d'accueil.
!Manuel utilisateur FEC Normalizer.docx

# Variables d'environnement (secrets éventuels — jamais dans Git)
.env
.env.local
*.secret
